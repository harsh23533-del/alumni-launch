+                <button className="btn btn-brass" onClick={() => messageAuthor(openIdea)} style={{ flex: 1 }}>
+                  Message {openIdea.student_name}
+                </button>
+              )}
+            </div>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
+
+const overlayStyle = {
+  position: 'fixed', inset: 0, background: 'rgba(22,33,62,0.45)',
